# Store the real file outside the checkout, with mode 0600.
TZ=UTC
# Change this to the NAS LAN address if LAN access is required.
FETCHSHELF_BIND_IP=127.0.0.1
FETCHSHELF_WEBUI_PORT=5556
FETCHSHELF_SETTINGS_DIR=/mnt/pool/fetchshelf-data/settings
FETCHSHELF_DATA_DIR=/mnt/pool/fetchshelf-data/media
FETCHSHELF_IDENTITY_KEY_FILE=/mnt/pool/fetchshelf-data/secrets/identity.key
FETCHSHELF_API_TOKEN=replace-with-the-existing-token
