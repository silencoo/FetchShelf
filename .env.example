TZ=Asia/Shanghai
WEBUI_PORT=5555
SETTINGS_DIR=./settings
DOWNLOADS_DIR=./downloads

# Required when WebUI is accessed from Docker, a LAN address, or the Internet.
FETCHSHELF_API_TOKEN=

# 32-byte key encoded as base64 or hex. Keep it outside the settings volume.
# Docker Secrets via FETCHSHELF_IDENTITY_KEY_FILE are preferred for production.
FETCHSHELF_IDENTITY_KEY=
